# Supabase のプロジェクト設定 > API からコピーする
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 公開してよいキー（publishable key。従来の anon key でも可）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用のキー（secret key。従来の service_role key でも可）。絶対に公開しない
SUPABASE_SECRET_KEY=
# 管理者のGoogleアカウントのメールアドレス。この人だけが承認できる
ADMIN_EMAIL=
